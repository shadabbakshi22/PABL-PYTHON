class Solution:
    def combinationSum(self, n, k):
        ans = []

        def backtrack(start, k, target, path):
            # if valid combination found
            if k == 0 and target == 0:
                ans.append(path[:])
                return
            
            # stop if invalid
            if k == 0 or target < 0:
                return

            # try numbers from start to 9
            for num in range(start, 10):
                path.append(num)
                backtrack(num + 1, k - 1, target - num, path)
                path.pop()

        backtrack(1, k, n, [])
        return ans
