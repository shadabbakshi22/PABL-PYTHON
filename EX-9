class Solution:
    def countSubarrays(self, arr):
        n = len(arr)
        stack = []
        next_smaller = [n] * n   # default = n (no smaller element)

        # Find next smaller element index for each position
        for i in range(n):
            while stack and arr[stack[-1]] > arr[i]:
                next_smaller[stack.pop()] = i
            stack.append(i)

        # Count valid subarrays
        ans = 0
        for i in range(n):
            ans += next_smaller[i] - i

        return ans
