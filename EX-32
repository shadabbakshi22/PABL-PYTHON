class Solution:
    def threeWayPartition(self, arr, a, b):
        n = len(arr)

        low = 0        # next position for < a
        mid = 0        # current element
        high = n - 1   # next position for > b

        while mid <= high:
            if arr[mid] < a:
                arr[low], arr[mid] = arr[mid], arr[low]
                low += 1
                mid += 1

            elif arr[mid] > b:
                arr[mid], arr[high] = arr[high], arr[mid]
                high -= 1

            else:  # a <= arr[mid] <= b
                mid += 1

        return arr
