class Solution:
    def has132Pattern(self, arr):
        stack = []
        third = float('-inf')   # arr[k] candidate

        # traverse from right
        for i in range(len(arr) - 1, -1, -1):

            # check arr[i] < arr[k]
            if arr[i] < third:
                return True

            # update arr[k]
            while stack and arr[i] > stack[-1]:
                third = stack.pop()

            stack.append(arr[i])

        return False
