class Solution:
    def preGreaterEle(self, arr):
        stack = []
        result = []

        for x in arr:
            # remove smaller or equal elements
            while stack and stack[-1] <= x:
                stack.pop()

            # assign previous greater element
            if not stack:
                result.append(-1)
            else:
                result.append(stack[-1])

            stack.append(x)

        return result
