class Solution:
    def minSwap(self, arr, k):
        n = len(arr)

        # Step 1: count elements <= k
        good = 0
        for x in arr:
            if x <= k:
                good += 1

        # Step 2: count bad elements in first window
        bad = 0
        for i in range(good):
            if arr[i] > k:
                bad += 1

        ans = bad

        # Step 3: slide window
        i = 0
        j = good

        while j < n:
            # remove left element
            if arr[i] > k:
                bad -= 1

            # add right element
            if arr[j] > k:
                bad += 1

            ans = min(ans, bad)

            i += 1
            j += 1

        return ans
