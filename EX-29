class Solution:
    def maxSubseq(self, s, k):
        stack = []

        for ch in s:
            # Remove smaller characters to make result larger
            while stack and k > 0 and stack[-1] < ch:
                stack.pop()
                k -= 1
            stack.append(ch)

        # If removals still left, remove from end
        if k > 0:
            stack = stack[:-k]

        return "".join(stack)
