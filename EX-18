class Solution:
    def mergeArrays(self, a, b):

        n = len(a)
        m = len(b)

        # next gap function
        def nextGap(gap):
            if gap <= 1:
                return 0
            return (gap // 2) + (gap % 2)

        gap = nextGap(n + m)

        while gap > 0:
            i = 0
            j = gap

            while j < n + m:

                # get values
                if i < n:
                    val_i = a[i]
                else:
                    val_i = b[i - n]

                if j < n:
                    val_j = a[j]
                else:
                    val_j = b[j - n]

                # swap if needed
                if val_i > val_j:
                    if i < n and j < n:
                        a[i], a[j] = a[j], a[i]
                    elif i < n and j >= n:
                        a[i], b[j - n] = b[j - n], a[i]
                    else:
                        b[i - n], b[j - n] = b[j - n], b[i - n]

                i += 1
                j += 1

            gap = nextGap(gap)
